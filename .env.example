# Copy to .env (local dev: node --env-file=.env server/main.js) or .env.docker (the compose
# stack; scripts/setup-zimaos-db.sh writes it). Never commit the filled copy.
DATABASE_URL=postgresql://habits:<password>@<postgres host>:5432/habits
PORT=4180
# memory = no database (tests, e2e); postgres = DATABASE_URL above
HABITS_STORE=postgres
# The list's CSV file (edit it by hand, the page follows). Default: state/items.csv next to the
# server (the compose stack mounts ./state there). Empty keeps the list in the database instead.
# HABITS_ITEMS_CSV=state/items.csv

{
  "name": "habits",
  "version": "1.0.0",
  "description": "Black-and-white ink style list of things to read, watch, build and keep up with. Static site + a small Node server that keeps the state in PostgreSQL.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env server/main.js",
    "start": "node server/main.js",
    "serve": "HABITS_STORE=memory node server/main.js",
    "test": "node --test tests/*.test.mjs",
    "e2e": "playwright test",
    "check": "scripts/check",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "prettier": "^3.6.2",
    "serve": "^14.2.4"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "engines": {
    "node": ">=22"
  }
}
